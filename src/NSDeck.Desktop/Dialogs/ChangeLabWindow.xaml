<Window x:Class="NSDeck.Desktop.Dialogs.ChangeLabWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DNS Change Lab" Height="900" Width="1500" MinHeight="720" MinWidth="1120"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="230"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="DNS Change Lab" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock Text="Search every provider, understand the blast radius, and deploy one guarded multi-zone transaction." Margin="0,6,0,0" Foreground="{StaticResource MutedTextBrush}"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Refresh Global Inventory" MinWidth="176" Style="{StaticResource PrimaryButtonStyle}" Click="RefreshInventory_Click"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,18,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" ToolTip="Search provider, domain, name, type, or value"/>
            <Button Grid.Column="1" Content="Select All Matches" Margin="10,0,0,0" MinWidth="135" Style="{StaticResource ToolbarButtonStyle}" Click="SelectMatches_Click"/>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2.25*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
            <DataGrid x:Name="InventoryGrid" Grid.Column="0" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" SelectionChanged="InventoryGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Provider" Binding="{Binding Provider}" Width="130"/>
                    <DataGridTextColumn Header="Domain" Binding="{Binding Domain}" Width="190"/>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="170"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="75"/>
                    <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" MinWidth="240"/>
                    <DataGridTextColumn Header="TTL" Binding="{Binding Ttl}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="#EEF1F5"/>
            <Border Grid.Column="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="14">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="Blast radius and dependencies" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ImpactSummaryText" Grid.Row="1" Text="Select one or more records to analyze." Margin="0,6,0,10" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"/>
                    <TreeView x:Name="ImpactTree" Grid.Row="2" BorderThickness="0" Background="Transparent"/>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,14,0,12" Background="#FAFBFC">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Find in value" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox x:Name="FindValueBox" Grid.Column="1" Margin="10,0,18,0"/>
                <TextBlock Grid.Column="2" Text="Replace with" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox x:Name="ReplacementBox" Grid.Column="3" Margin="10,0,18,0"/>
                <Button Grid.Column="4" Content="Add to Change Plan" MinWidth="150" Style="{StaticResource PrimaryButtonStyle}" Click="StageReplacement_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="PlanHeading" Text="Coordinated Change Plan (0)" FontSize="16" FontWeight="SemiBold"/>
                <Button Grid.Column="1" Content="Clear Plan" Style="{StaticResource ToolbarButtonStyle}" Click="ClearPlan_Click"/>
            </Grid>
            <DataGrid x:Name="PlanGrid" Grid.Row="1" IsReadOnly="True" SelectionMode="Extended">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Provider" Binding="{Binding Provider}" Width="130"/>
                    <DataGridTextColumn Header="Domain" Binding="{Binding Domain}" Width="180"/>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="150"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="70"/>
                    <DataGridTextColumn Header="Before" Binding="{Binding Before}" Width="*" MinWidth="220"/>
                    <DataGridTextColumn Header="After" Binding="{Binding After}" Width="*" MinWidth="220"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Grid Grid.Row="5" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Text="Loading global inventory…" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Close" MinWidth="92" Style="{StaticResource ToolbarButtonStyle}" Click="Close_Click"/>
                <Button x:Name="ApplyPlanButton" Content="Apply Plan with Rollback" MinWidth="190" Margin="8,0,0,0" Style="{StaticResource PrimaryButtonStyle}" Click="ApplyPlan_Click" IsEnabled="False"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
