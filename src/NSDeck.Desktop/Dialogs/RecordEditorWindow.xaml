<Window x:Class="NSDeck.Desktop.Dialogs.RecordEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DNS Record" Height="500" Width="620"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="HeadingText" Grid.Row="0" Text="New DNS record" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,22"/>
        <Grid Grid.Row="1" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Name" VerticalAlignment="Center"/><TextBox x:Name="NameBox" Grid.Column="1" ToolTip="Use @ for the zone apex"/></Grid>
        <Grid Grid.Row="2" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Type" VerticalAlignment="Center"/><ComboBox x:Name="TypeBox" Grid.Column="1" SelectionChanged="TypeBox_SelectionChanged"/></Grid>
        <Grid Grid.Row="3" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Value" VerticalAlignment="Center"/><TextBox x:Name="ValueBox" Grid.Column="1" TextWrapping="Wrap" AcceptsReturn="True" Height="76" VerticalContentAlignment="Top"/></Grid>
        <Grid Grid.Row="4" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="190"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="TTL" VerticalAlignment="Center"/><ComboBox x:Name="TtlBox" Grid.Column="1" DisplayMemberPath="Label" SelectedValuePath="Seconds"/>
            <TextBlock Grid.Column="2" Text="Priority" VerticalAlignment="Center" Margin="22,0,0,0"/><TextBox x:Name="PriorityBox" Grid.Column="3"/>
        </Grid>
        <Border Grid.Row="5" Padding="14" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" VerticalAlignment="Top">
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Text="Changes are staged locally. The complete zone will be validated and compared with Namecheap again before Apply Changes writes it."/>
        </Border>
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Style="{StaticResource ToolbarButtonStyle}" MinWidth="92" Click="Cancel_Click"/>
            <Button x:Name="SaveButton" Content="Add Record" Style="{StaticResource PrimaryButtonStyle}" MinWidth="112" Margin="8,0,0,0" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
