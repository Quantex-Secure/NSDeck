<Window x:Class="NSDeck.Desktop.Dialogs.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zone History" Height="520" Width="820"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Zone history" FontSize="24" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1" Margin="0,7,0,18" Text="Snapshots are captured immediately before every provider update." Foreground="{StaticResource MutedTextBrush}"/>
        <DataGrid x:Name="SnapshotsGrid" Grid.Row="2" IsReadOnly="True" ItemsSource="{Binding}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Created" Binding="{Binding CreatedAt, StringFormat={}{0:G}}" Width="190"/>
                <DataGridTextColumn Header="Provider" Binding="{Binding Provider}" Width="170"/>
                <DataGridTextColumn Header="Records" Binding="{Binding Records.Count}" Width="90"/>
                <DataGridTextColumn Header="Fingerprint" Binding="{Binding Fingerprint}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Close" MinWidth="92" Style="{StaticResource ToolbarButtonStyle}" Click="Close_Click"/>
            <Button Content="Stage Selected Snapshot" MinWidth="172" Margin="8,0,0,0" Style="{StaticResource PrimaryButtonStyle}" Click="Stage_Click"/>
        </StackPanel>
    </Grid>
</Window>
