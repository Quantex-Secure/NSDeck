<Window x:Class="NSDeck.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:NSDeck.Core.Models;assembly=NSDeck.Core"
        xmlns:vm="clr-namespace:NSDeck.Desktop.ViewModels"
        Title="NSDeck — Quantex Secure" Height="900" Width="1500"
        MinHeight="680" MinWidth="1100" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/><RowDefinition Height="54"/><RowDefinition Height="2"/>
            <RowDefinition Height="*"/><RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,0">
            <MenuItem Header="_File">
                <MenuItem Header="DNS Provider Accounts…" Click="Settings_Click"/>
                <Separator/>
                <MenuItem Header="Export Current Zone…" Click="Export_Click"/>
                <MenuItem Header="Import Zone Snapshot…" Click="Import_Click"/>
                <MenuItem Header="Export Shareable Diagnostic Report…" Click="ExportDiagnostics_Click"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Action">
                <MenuItem Header="New Record…" Click="NewRecord_Click"/>
                <MenuItem Header="Edit Record…" Click="EditRecord_Click"/>
                <MenuItem Header="Delete" Click="DeleteRecord_Click"/>
                <Separator/>
                <MenuItem Header="Check Public DNS…" Click="PublicDnsCheck_Click" IsEnabled="{Binding CanCheckPublicDns}"/>
                <MenuItem Header="DNS Change Lab…" Click="ChangeLab_Click"/>
                <Separator/>
                <MenuItem Header="Apply Changes" Click="ApplyChanges_Click"/>
                <MenuItem Header="Refresh" Click="Refresh_Click"/>
            </MenuItem>
            <MenuItem Header="_View"><MenuItem Header="Zone History…" Click="History_Click"/></MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="Check for Updates…" Click="CheckUpdates_Click"/>
                <Separator/>
                <MenuItem Header="About NSDeck" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Background="{StaticResource WindowBrush}">
            <DockPanel Margin="12,0" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ToolbarButtonStyle}" Click="Refresh_Click" IsEnabled="{Binding HasSelectedDomain}">
                        <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconRefresh}" Fill="{StaticResource AccentBrush}" Width="19" Height="19" Stretch="Uniform"/><TextBlock Text="Refresh" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <Border Width="1" Height="30" Background="{StaticResource BorderBrush}" Margin="8,0"/>
                    <Button Style="{StaticResource ToolbarButtonStyle}" Click="NewRecord_Click" IsEnabled="{Binding HasSelectedDomain}">
                        <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconAdd}" Fill="{StaticResource AccentBrush}" Width="18" Height="18" Stretch="Uniform"/><TextBlock Text="New Record" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" Click="DeleteRecord_Click" IsEnabled="{Binding HasSelectedRecord}">
                        <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconDelete}" Fill="{StaticResource TextBrush}" Width="18" Height="18" Stretch="Uniform"/><TextBlock Text="Delete" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <Border Width="1" Height="30" Background="{StaticResource BorderBrush}" Margin="8,0"/>
                    <Button Style="{StaticResource ToolbarButtonStyle}" Click="ApplyChanges_Click" IsEnabled="{Binding HasPendingChanges}">
                        <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconApply}" Fill="{StaticResource AccentBrush}" Width="19" Height="19" Stretch="Uniform"/><TextBlock Text="Apply Changes" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <Border Width="1" Height="30" Background="{StaticResource BorderBrush}" Margin="8,0"/>
                    <Button Style="{StaticResource ToolbarButtonStyle}" Click="PublicDnsCheck_Click" IsEnabled="{Binding CanCheckPublicDns}" ToolTip="Queries public resolvers; unavailable for internal Windows DNS zones">
                        <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconGlobe}" Fill="{StaticResource AccentBrush}" Width="18" Height="18" Stretch="Uniform"/><TextBlock Text="Check Public DNS" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" Click="ChangeLab_Click">
                        <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconGlobe}" Fill="{StaticResource WarningBrush}" Width="18" Height="18" Stretch="Uniform"/><TextBlock Text="Change Lab" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                </StackPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarButtonStyle}" Click="Settings_Click" ToolTip="DNS provider accounts" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconSettings}" Fill="{StaticResource MutedTextBrush}" Width="18" Height="18" Stretch="Uniform"/><TextBlock Text="Settings" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel>
                </Button>
            </DockPanel>
        </Border>

        <ProgressBar Grid.Row="2" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" BorderThickness="0" Foreground="{StaticResource AccentBrush}"/>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Background="#FBFCFE">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,0">
                        <TextBlock Text="Accounts" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                    </Border>
                    <TreeView x:Name="DomainsTree" Grid.Row="1" ItemsSource="{Binding Accounts}" Background="Transparent" BorderThickness="0" Padding="8,10" SelectedItemChanged="DomainsTree_SelectedItemChanged">
                        <TreeView.Resources>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="True"/>
                                <Setter Property="Padding" Value="5"/>
                                <Setter Property="Margin" Value="0,1"/>
                            </Style>
                            <HierarchicalDataTemplate DataType="{x:Type vm:ProviderAccountViewModel}" ItemsSource="{Binding Domains}">
                                <StackPanel Orientation="Horizontal" Margin="2,3">
                                    <Border Width="24" Height="24" Background="{StaticResource AccentBrush}" CornerRadius="4"><TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                    <TextBlock Text="{Binding Name}" Margin="9,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                            <DataTemplate DataType="{x:Type models:DomainSummary}">
                                <StackPanel Orientation="Horizontal" Margin="2,2">
                                    <Path Data="{StaticResource IconGlobe}" Fill="{StaticResource AccentBrush}" Width="18" Height="18" Stretch="Uniform"/>
                                    <TextBlock Text="{Binding Name}" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                </Grid>
            </Border>
            <GridSplitter Grid.Column="1" Width="5" Background="#F0F2F5" HorizontalAlignment="Stretch"/>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="70"/><RowDefinition Height="56"/><RowDefinition Height="*"/><RowDefinition Height="178"/></Grid.RowDefinitions>
                <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="18,0">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconGlobe}" Fill="{StaticResource AccentBrush}" Width="28" Height="28" Stretch="Uniform"/>
                            <TextBlock Text="{Binding CurrentDomainName}" FontSize="24" FontWeight="SemiBold" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,28,0">
                            <TextBlock Text="Provider:" Foreground="{StaticResource MutedTextBrush}"/><TextBlock Text="{Binding ProviderDisplay}" Margin="5,0,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="9" Height="9" Fill="{StaticResource SuccessBrush}"/><TextBlock Text="{Binding LastRefreshedText}" Margin="8,0,0,0" Foreground="{StaticResource MutedTextBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Background="#FCFDFE" Padding="14,9">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <TextBox x:Name="FilterBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Filter by name, type, or value"/>
                            <TextBlock Text="Filter records…" Foreground="#8A95A5" Margin="10,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SearchText}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <ComboBox Grid.Column="1" Margin="12,0,0,0" ItemsSource="{Binding RecordTypes}" SelectedItem="{Binding SelectedType}"/>
                        <CheckBox Grid.Column="3" Content="Show only modified" IsChecked="{Binding ShowOnlyModified}" VerticalAlignment="Center" Margin="20,0"/>
                        <Button Grid.Column="4" Content="Reset" Style="{StaticResource ToolbarButtonStyle}" Click="ResetFilter_Click"/>
                    </Grid>
                </Border>

                <DataGrid x:Name="RecordsGrid" Grid.Row="2" ItemsSource="{Binding RecordsView}" SelectedItem="{Binding SelectedRecord}" IsReadOnly="True"
                          SelectionMode="Extended" SelectionUnit="FullRow" MouseDoubleClick="RecordsGrid_MouseDoubleClick" PreviewKeyDown="RecordsGrid_PreviewKeyDown">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="105"/>
                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" MinWidth="280"/>
                        <DataGridTextColumn Header="TTL" Binding="{Binding TtlDisplay}" Width="120"/>
                        <DataGridTextColumn Header="Priority" Binding="{Binding PriorityDisplay}" Width="90"/>
                        <DataGridTemplateColumn Header="Status" Width="120">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Status}" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="Add"><Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Update"><Setter Property="Foreground" Value="{StaticResource WarningBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Grid Grid.Row="3" Background="{StaticResource WindowBrush}">
                    <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,1" Padding="14,0">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="10" Height="10" Fill="{StaticResource WarningBrush}"/><TextBlock Text="{Binding PendingChangesText}" FontWeight="SemiBold" Margin="9,0,0,0"/></StackPanel>
                            <Button Grid.Column="1" Content="Clear All" Style="{StaticResource ToolbarButtonStyle}" Click="ClearChanges_Click" IsEnabled="{Binding HasPendingChanges}"/>
                        </Grid>
                    </Border>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding PendingChanges}" IsReadOnly="True" ColumnHeaderHeight="32" RowHeight="32">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="100"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Record.Name}" Width="180"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding Record.Type}" Width="105"/>
                            <DataGridTextColumn Header="Value" Binding="{Binding Record.Value}" Width="*"/>
                            <DataGridTextColumn Header="TTL" Binding="{Binding Record.TtlSeconds}" Width="100"/>
                            <DataGridTextColumn Header="Priority" Binding="{Binding Record.Priority}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Background="{StaticResource SurfaceBrush}">
            <Grid Margin="16,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="8" Height="8" Fill="{StaticResource WarningBrush}"/><TextBlock Text="{Binding StatusMessage}" Margin="8,0,0,0"/></StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding RecordCountText}" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,26,0"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}"/><TextBlock Text="{Binding ConnectionStatus}" Margin="8,0,0,0"/></StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
